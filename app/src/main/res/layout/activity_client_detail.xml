<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============ Protected content ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header: stays visible even when shielded, so the user knows where they are -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/screenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/client_detail_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/statusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/guard_status_on"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />
            </LinearLayout>

            <TextView
                android:id="@+id/lowVisibilityBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_warn_banner"
                android:padding="10dp"
                android:text="@string/low_visibility_banner"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />

            <!--
              The container whose children are redacted in PARTIAL mode. In FULL mode an opaque
              overlay covers it entirely.
            -->
            <LinearLayout
                android:id="@+id/sensitiveContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_name"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />

                    <TextView
                        android:id="@+id/valueName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/client_name"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_id"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />

                    <TextView
                        android:id="@+id/valueId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/client_id"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_phone"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />

                    <TextView
                        android:id="@+id/valuePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/client_phone"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_balance"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />

                    <TextView
                        android:id="@+id/valueBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/client_balance"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_transactions"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/valueTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/client_transactions"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>

            <TextView
                android:id="@+id/debugHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />

            <!--
              QA-only: shown exclusively in debug builds so the three shield states can be
              inspected without a second human in front of the camera. Dead in release builds.
            -->
            <LinearLayout
                android:id="@+id/qaBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/qaNone"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QA:NONE" />

                <Button
                    android:id="@+id/qaPartial"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QA:PARTIAL" />

                <Button
                    android:id="@+id/qaFull"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QA:FULL" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============ PARTIAL reveal affordance ============ -->
    <LinearLayout
        android:id="@+id/partialBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_warn_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/partial_bar_text"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <Button
            android:id="@+id/continueButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shield_continue" />
    </LinearLayout>

    <!-- ============ FULL opaque shield ============ -->
    <LinearLayout
        android:id="@+id/fullShield"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shield_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shield" />

        <TextView
            android:id="@+id/fullShieldTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/shield_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/shield_fg" />

        <TextView
            android:id="@+id/fullShieldBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/shield_body"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/shield_fg" />

        <!-- Only ever shown for CAMERA_OBSTRUCTED (the user holding a hand over the lens). -->
        <Button
            android:id="@+id/shieldAction"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/shield_continue"
            android:textColor="@color/shield_icon"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fullShieldScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/shield_scope"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/shield_scope_fg" />
    </LinearLayout>
</FrameLayout>
